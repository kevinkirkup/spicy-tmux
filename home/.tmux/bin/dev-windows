#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "click", "jinja2"]
# ///
"""
dev-windows — manage tmux development window configs

Templates live in ~/.tmux/templates/*.j2 (tracked in repo).
Machine-local templates can be added to ~/.tmux/local/templates/*.j2
and will take precedence over the shared ones.
"""

import os
import re
from pathlib import Path

import click
import yaml
from jinja2 import Environment, FileSystemLoader, TemplateNotFound

LOCAL_DIR       = Path(os.environ.get("TMUX_LOCAL_DIR", "~/.tmux/local")).expanduser()
TEMPLATES_DIR   = Path("~/.tmux/templates").expanduser()
LOCAL_TMPL_DIR  = LOCAL_DIR / "templates"
CONFIG_FILE     = LOCAL_DIR / "windows.yaml"
BINDINGS_FILE   = LOCAL_DIR / "bindings.conf"


# ---------------------------------------------------------------------------
# Template loading
# ---------------------------------------------------------------------------

def get_template(name: str):
    """Load a Jinja2 template by name, checking local overrides first."""
    search_path = []
    if LOCAL_TMPL_DIR.exists():
        search_path.append(str(LOCAL_TMPL_DIR))
    search_path.append(str(TEMPLATES_DIR))

    env = Environment(
        loader=FileSystemLoader(search_path),
        trim_blocks=True,
        lstrip_blocks=True,
        keep_trailing_newline=True,
    )
    try:
        return env.get_template(f"{name}.j2")
    except TemplateNotFound:
        raise click.ClickException(
            f"Template '{name}' not found. "
            f"Add {name}.j2 to {TEMPLATES_DIR} or {LOCAL_TMPL_DIR}"
        )


def list_templates() -> list[str]:
    """Return available template names from both template dirs."""
    seen = set()
    names = []
    for d in (LOCAL_TMPL_DIR, TEMPLATES_DIR):
        if d.exists():
            for f in sorted(d.glob("*.j2")):
                if f.stem not in seen:
                    names.append(f.stem)
                    seen.add(f.stem)
    return names


# ---------------------------------------------------------------------------
# Config file
# ---------------------------------------------------------------------------

def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    with CONFIG_FILE.open() as f:
        return yaml.safe_load(f) or {}


def save_config(config: dict) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with CONFIG_FILE.open("w") as f:
        yaml.dump(config, f, default_flow_style=False, allow_unicode=True, sort_keys=False)


# ---------------------------------------------------------------------------
# Tmux config generation
# ---------------------------------------------------------------------------

def get_init(directory: str) -> str:
    d = Path(directory).expanduser()
    if (d / "envsetup.sh").exists():
        return f"{directory} && source envsetup.sh && clear"
    return f"cd {directory} && clear"


def resolve_pane_vars(entry: dict, pane_count: int = 7) -> dict:
    """Derive per-pane dir/init/cmd variables for template rendering."""
    window_dir = entry["dir"]
    panes = entry.get("panes", {})
    result = {}
    for i in range(pane_count):
        pane = panes.get(f"P{i}", {})
        if isinstance(pane, str):
            pane = {"label": pane}
        pane_dir = pane.get("dir", window_dir)
        result[f"dir_P{i}"] = pane_dir
        result[f"init_P{i}"] = get_init(pane_dir)
        result[f"cmd_P{i}"] = pane.get("cmd", "")
    return result


def get_pane_labels(panes: dict) -> dict:
    """Extract L0–L3 label variables from the pane object format."""
    labels = {}
    for i in range(4):
        pane = panes.get(f"P{i}", {})
        if isinstance(pane, str):
            labels[f"L{i}"] = pane
        else:
            labels[f"L{i}"] = pane.get("label", "")
    return labels


def render(name: str, entry: dict) -> str:
    panes = entry.get("panes", {})
    template = get_template(entry.get("template", "default"))
    return template.render(
        name=name,
        dir=entry["dir"],
        init=get_init(entry["dir"]),
        **get_pane_labels(panes),
        **resolve_pane_vars(entry),
    )


def write_window(name: str, entry: dict) -> None:
    path = LOCAL_DIR / name
    path.write_text(render(name, entry))
    click.echo(f"  written:  {path}")


def delete_window(name: str) -> None:
    path = LOCAL_DIR / name
    if path.exists():
        path.unlink()
        click.echo(f"  deleted:  {path}")


# ---------------------------------------------------------------------------
# bindings.conf management
# ---------------------------------------------------------------------------

def add_binding(name: str) -> None:
    if not BINDINGS_FILE.exists():
        return

    text = BINDINGS_FILE.read_text()
    pattern = rf"set -s command-alias\[(\d+)\] {re.escape(name)}=.*"
    existing = re.search(pattern, text)

    if existing:
        idx = existing.group(1)
        replacement = f"set -s command-alias[{idx}] {name}='source-file ~/.tmux/local/{name}'"
        BINDINGS_FILE.write_text(re.sub(pattern, replacement, text))
        click.echo(f"  updated:  binding [{idx}] {name}")
    else:
        indices = [int(m) for m in re.findall(r"command-alias\[(\d+)\]", text)]
        idx = (max(indices) + 1) if indices else 100
        new_line = f"set -s command-alias[{idx}] {name}='source-file ~/.tmux/local/{name}'"
        BINDINGS_FILE.write_text(text.rstrip("\n") + "\n" + new_line + "\n")
        click.echo(f"  added:    binding [{idx}] {name}")


def remove_binding(name: str) -> None:
    if not BINDINGS_FILE.exists():
        return

    text = BINDINGS_FILE.read_text()
    pattern = rf"set -s command-alias\[\d+\] {re.escape(name)}=.*\n?"
    if re.search(pattern, text):
        BINDINGS_FILE.write_text(re.sub(pattern, "", text))
        click.echo(f"  removed:  binding {name}")
    else:
        click.echo(f"  warning:  binding '{name}' not found in bindings.conf", err=True)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

@click.group()
def cli():
    """Manage tmux development window configs."""


@cli.command()
def generate():
    """Regenerate all config files from windows.yaml."""
    config = load_config()
    if not config:
        raise click.ClickException(f"No windows configured. Add entries to {CONFIG_FILE}")
    click.echo(f"Generating {len(config)} window config(s)...")
    for name, entry in config.items():
        write_window(name, entry)
        add_binding(name)


@cli.command()
@click.option("-n", "name",      required=True, help="Window name")
@click.option("-d", "directory", required=True, help="Project directory")
@click.option("-t", "template",  default="default", show_default=True, help="Template name")
@click.option("--l0", default=None, metavar="label", help="Pane 0 label (default: Watch)")
@click.option("--l1", default=None, metavar="label", help="Pane 1 label (default: Logs)")
@click.option("--l2", default=None, metavar="label", help="Pane 2 label (optional)")
@click.option("--l3", default=None, metavar="label", help="Pane 3 label (default: Tests)")
@click.option("--p0-dir", default=None, metavar="dir", help="Pane 0 working directory")
@click.option("--p1-dir", default=None, metavar="dir", help="Pane 1 working directory")
@click.option("--p2-dir", default=None, metavar="dir", help="Pane 2 working directory")
@click.option("--p3-dir", default=None, metavar="dir", help="Pane 3 working directory")
@click.option("--p4-dir", default=None, metavar="dir", help="Pane 4 working directory")
@click.option("--p5-dir", default=None, metavar="dir", help="Pane 5 working directory")
@click.option("--p6-dir", default=None, metavar="dir", help="Pane 6 working directory")
@click.option("--p0-cmd", default=None, metavar="cmd", help="Pane 0 command override")
@click.option("--p1-cmd", default=None, metavar="cmd", help="Pane 1 command override")
@click.option("--p2-cmd", default=None, metavar="cmd", help="Pane 2 command override")
@click.option("--p3-cmd", default=None, metavar="cmd", help="Pane 3 command override")
@click.option("--p4-cmd", default=None, metavar="cmd", help="Pane 4 command override")
@click.option("--p5-cmd", default=None, metavar="cmd", help="Pane 5 command override")
@click.option("--p6-cmd", default=None, metavar="cmd", help="Pane 6 command override")
def add(name, directory, template, l0, l1, l2, l3,
        p0_dir, p1_dir, p2_dir, p3_dir, p4_dir, p5_dir, p6_dir,
        p0_cmd, p1_cmd, p2_cmd, p3_cmd, p4_cmd, p5_cmd, p6_cmd):
    """Add or update a window in windows.yaml."""
    config = load_config()

    label_vals = [l0, l1, l2, l3, None, None, None]
    dir_vals   = [p0_dir, p1_dir, p2_dir, p3_dir, p4_dir, p5_dir, p6_dir]
    cmd_vals   = [p0_cmd, p1_cmd, p2_cmd, p3_cmd, p4_cmd, p5_cmd, p6_cmd]

    panes = {}
    for i in range(7):
        obj = {}
        if i < 4 and label_vals[i] is not None:
            obj["label"] = label_vals[i]
        if dir_vals[i] is not None:
            obj["dir"] = dir_vals[i]
        if cmd_vals[i] is not None:
            obj["cmd"] = cmd_vals[i]
        if obj:
            panes[f"P{i}"] = obj

    entry = {
        "dir": directory,
        "template": template,
        **({"panes": panes} if panes else {}),
    }
    verb = "Updated" if name in config else "Added"
    config[name] = entry
    save_config(config)
    click.echo(f"{verb} '{name}' in {CONFIG_FILE}")
    write_window(name, entry)
    add_binding(name)


@cli.command()
@click.argument("name")
def remove(name):
    """Remove a window config, its file, and its binding."""
    config = load_config()
    if name not in config:
        raise click.ClickException(f"'{name}' not found in {CONFIG_FILE}")
    del config[name]
    save_config(config)
    click.echo(f"Removed '{name}' from {CONFIG_FILE}")
    delete_window(name)
    remove_binding(name)


@cli.command(name="list")
def list_windows():
    """List all configured windows."""
    config = load_config()
    if not config:
        click.echo(f"No windows configured. Edit {CONFIG_FILE}")
        return
    for name, entry in config.items():
        panes = entry.get("panes", {})
        tmpl = entry.get("template", "default")
        click.echo(f"  {name:<32} {entry['dir']}  [{tmpl}]")
        for pk, pane in panes.items():
            if isinstance(pane, str):
                parts = f"label={pane}"
            else:
                parts = "  ".join(f"{k}={v}" for k, v in pane.items())
            click.echo(f"  {'':32} {pk}: {parts}")


@cli.command()
def templates():
    """List available templates."""
    names = list_templates()
    if not names:
        click.echo("No templates found.")
        return
    for name in names:
        click.echo(f"  {name}")


if __name__ == "__main__":
    cli()
