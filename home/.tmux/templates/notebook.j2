# vim: set filetype=tmux:
# Managed by dev-windows — edit ~/.tmux/local/windows.yaml to update
new-window -n {{ name }} -c '{{ dir }}'
split-window -h -l 50% -t 0
split-window -v -l 50% -t 1

set-option -p -t .0 @pane_label '{{ L0 or "Server" }}'
set-option -p -t .1 @pane_label 'Editor'
set-option -p -t .2 @pane_label 'Console'

send-keys -t 0 '{{ init }}' Enter
send-keys -t 1 '{{ init }} && nvim .' Enter
send-keys -t 2 '{{ init }}' Enter
