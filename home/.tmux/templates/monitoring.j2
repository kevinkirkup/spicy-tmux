# vim: set filetype=tmux:
# Managed by dev-windows — edit ~/.tmux/local/windows.yaml to update
new-window -n {{ name }} -c '{{ dir }}'
split-window -v -l 90% -t 0
split-window -h -l 50% -t 0
split-window -h -l 70% -t 2
split-window -v -l 15 -t 3
split-window -v -l 80 -t 2

set-option -p -t .0 @pane_label '{{ L0 or "Log" }}'
set-option -p -t .1 @pane_label '{{ L1 or "Misc" }}'
set-option -p -t .2 @pane_label '{{ L2 or "Monitoring" }}'
set-option -p -t .4 @pane_label 'Editor'
set-option -p -t .5 @pane_label 'Console'
set-option -p -t .6 @pane_label 'Working'

send-keys -t 0 '{{ init }}' Enter
send-keys -t 1 '{{ init }}' Enter
send-keys -t 3 '{{ init }}' Enter
send-keys -t 4 '{{ init }} && nvim .' Enter
send-keys -t 5 '{{ init }}' Enter
